# X (Twitter) API 認証情報
# https://developer.twitter.com/en/portal/dashboard で取得
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Claude API（日本語要約・ハルシネーション検証・フィードバック修正に使用）
# https://console.anthropic.com で取得
ANTHROPIC_API_KEY=

# Telegram Bot（投稿前レビュー通知に使用）
# 取得方法: Telegramで @BotFather に話しかけ /newbot → トークンを取得
TELEGRAM_BOT_TOKEN=
# 取得方法: @userinfobot に話しかけると自分のChat IDが表示される
TELEGRAM_CHAT_ID=

# Google Cloud TTS（動画ナレーション音声生成に使用）
# 取得方法: console.cloud.google.com → APIキー作成 → Text-to-Speech API有効化
GOOGLE_CLOUD_API_KEY=

# YouTube Data API（動画自動アップロードに使用）
# 取得方法: console.cloud.google.com → OAuth2クライアントID作成
# → https://developers.google.com/youtube/v3/guides/auth/server-side-web-apps
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
